<section id="contact" class="section-pad" style="background:var(--bg);">
  <div class="container">
    <div style="max-width:700px;">

      <div class="label reveal" style="margin-bottom:32px;">Contact</div>

      <h2 class="reveal" style="font-family:var(--font-display);font-size:clamp(40px,7vw,80px);font-weight:400;color:var(--text);letter-spacing:-3px;line-height:0.92;margin:0 0 32px;">
        Let's build<br />
        <span style="color:var(--lime);font-style:italic;">something great.</span>
      </h2>

      <p class="reveal" style="font-family:var(--font-body);font-size:15px;color:var(--text-muted);line-height:1.8;max-width:460px;margin:0 0 48px;">
        Studio looking for a senior Unity hire? Team that needs a reliable remote contractor? I'm currently available — reach out directly.
      </p>

      <div class="reveal" style="display:flex;flex-direction:column;gap:12px;align-items:flex-start;">
        <a href="mailto:anuj132000@gmail.com" class="btn btn-lime" style="font-size:15px;padding:15px 32px;">
          ✉ anuj132000@gmail.com
        </a>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
          <a href="https://www.linkedin.com/in/anuj-jain-gamesdev" target="_blank" rel="noopener" class="btn btn-outline" style="font-size:13px;padding:10px 20px;">
            💼 LinkedIn
          </a>
          <a href="https://github.com/anuj-jain-13" target="_blank" rel="noopener" class="btn btn-outline" style="font-size:13px;padding:10px 20px;">
            🐙 GitHub
          </a>
        </div>
        <p style="font-family:var(--font-body);font-size:12px;color:var(--text-muted);margin-top:24px;letter-spacing:0.1em;opacity:0.6;">
          📍 INDIA · REMOTE-FIRST · AVAILABLE GLOBALLY · +91 9990871712
        </p>
      </div>

    </div>
  </div>
</section>
