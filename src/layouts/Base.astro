---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Anuj Jain · Senior Unity Developer",
  description = "Senior Unity Developer specialising in scalable game systems, mobile, WebGL, and remote collaboration. 13+ years. 5+ shipped titles."
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Netlify Identity for CMS auth -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <!-- Preconnect fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="grain">
    <slot />
    <script>
      // Handle Netlify Identity tokens that land on the main site
      // (invite, confirmation, recovery links all redirect here first)
      const hash = window.location.hash;
      const hasToken =
        hash.includes("invite_token=") ||
        hash.includes("confirmation_token=") ||
        hash.includes("recovery_token=") ||
        hash.includes("access_token=");

      if (hasToken) {
        // Let the identity widget load and process the token,
        // then redirect to /admin so Decap CMS can finish the flow.
        window.netlifyIdentity?.on("init", () => {
          window.location.href = "/admin/" + hash;
        });
      } else if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", user => {
          if (!user) {
            window.netlifyIdentity.on("login", () => {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
  </body>
</html>
