---
const files = await Astro.glob('../content/site/hero.md');
const h = files[0]?.frontmatter ?? {};
const name         = h.name           ?? 'Anuj Jain';
const tagline      = h.tagline        ?? 'I build game systems that scale — across titles, teams, and time zones.';
const subTagline   = h.subTagline     ?? 'Slot frameworks, mobile games, WebGL — shipped and live.';
const keywords     = h.keywords       ?? ['Senior Unity Developer','Mobile','WebGL','Remote'];
const badge        = h.availableBadge ?? 'Available for Remote Roles';
const ctaPrimary   = h.ctaPrimary     ?? 'View My Work';
const ctaSecondary = h.ctaSecondary   ?? 'Get in touch';
const proofPoints  = h.proofPoints    ?? [
  { icon: '🚀', text: 'Live on Google Play' },
  { icon: '🎮', text: '5+ shipped titles' },
  { icon: '🌍', text: 'Remote · Europe & Asia' },
  { icon: '🤖', text: 'AI-assisted dev' },
];

const contactFiles = await Astro.glob('../content/site/contact.md');
const email = contactFiles[0]?.frontmatter?.email ?? 'anuj132000@gmail.com';
---

<section id="hero" style="
  background: var(--bg);
  position: relative;
  overflow: hidden;
  padding: clamp(72px,10vh,96px) clamp(18px,5vw,64px) 40px;
">
  <!-- Dot grid -->
  <div style="
    position:absolute;inset:0;pointer-events:none;z-index:0;
    background-image: radial-gradient(circle, rgba(0,0,0,0.07) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
  "></div>

  <div class="container" style="position:relative;z-index:1;">
    <div class="hero-grid" style="
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(24px,4vw,56px);
      align-items: center;
    ">

      <!-- LEFT -->
      <div style="opacity:0;animation:fadeUp 0.6s 0.05s both;">
        <span style="
          display:inline-flex;align-items:center;gap:7px;
          background:var(--green-bg);border:1px solid rgba(22,163,74,0.25);
          border-radius:100px;padding:4px 12px;margin-bottom:12px;
        ">
          <span style="width:6px;height:6px;border-radius:50%;background:var(--green);animation:pulse-dot 2s infinite;display:inline-block;flex-shrink:0;"></span>
          <span style="font-size:11px;font-weight:700;color:var(--green);letter-spacing:0.1em;">{badge.toUpperCase()}</span>
        </span>

        <h1 style="
          font-family:var(--font-head);font-weight:700;
          font-size:clamp(32px,4.5vw,52px);
          letter-spacing:-1.5px;line-height:1.08;
          color:var(--text);margin:0 0 12px;
        ">{name}</h1>

        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          {keywords.map((kw: string) => (
            <span style="
              font-size:13px;color:var(--accent);font-weight:700;
              background:var(--accent-bg);border:1px solid rgba(26,86,219,0.18);
              border-radius:100px;padding:4px 12px;
            ">{kw}</span>
          ))}
        </div>
      </div>

      <!-- RIGHT -->
      <div style="opacity:0;animation:fadeUp 0.65s 0.15s both;">
        <p style="
          font-size:clamp(15px,1.6vw,19px);
          color:var(--text);line-height:1.55;
          margin:0 0 6px;font-weight:500;
        ">{tagline}</p>

        {subTagline && (
          <p style="
            font-size:clamp(13px,1.2vw,15px);
            color:var(--text-muted);line-height:1.6;
            margin:0 0 20px;
          ">{subTagline}</p>
        )}

        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:18px;">
          <button class="btn btn-primary" onclick="smoothGo('#reel')" style="font-size:13px;padding:10px 20px;">{ctaPrimary} ↓</button>
          <a href={`mailto:${email}`} class="btn btn-outline" style="font-size:13px;padding:9px 18px;">{ctaSecondary}</a>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:6px;">
          {proofPoints.map((p: any) => (
            <span style="
              display:inline-flex;align-items:center;gap:5px;
              background:var(--card);border:1px solid var(--border);
              border-radius:100px;padding:4px 12px;
              font-size:12px;color:var(--text-muted);font-weight:600;
            ">
              <span style="font-size:11px;">{p.icon}</span>{p.text}
            </span>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Desktop: nudge content up by reducing top gap relative to nav */
  @media (min-width: 769px) {
    #hero {
      padding-top: 54px !important;
      padding-bottom: 32px !important;
    }
  }
  @media (max-width: 768px) {
    #hero {
      padding-top: 78px !important;
      padding-bottom: 24px !important;
    }
    .hero-grid {
      grid-template-columns: 1fr !important;
      gap: 20px !important;
    }
  }
</style>
