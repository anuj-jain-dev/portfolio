---
---
<section id="hero" style="
  min-height: 100vh;
  display: flex; align-items: center;
  padding: 100px clamp(18px,5vw,64px) 60px;
  background: var(--bg);
  position: relative; overflow: hidden;
">
  <!-- Subtle dot grid -->
  <div style="
    position:absolute;inset:0;pointer-events:none;
    background-image: radial-gradient(circle, rgba(0,0,0,0.08) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
  "></div>

  <div class="container" style="position:relative;width:100%;">
    <div style="max-width:780px;">

      <!-- Status badge -->
      <div style="margin-bottom:24px;opacity:0;animation:fadeUp 0.6s 0.1s both;">
        <span style="
          display:inline-flex;align-items:center;gap:8px;
          background:var(--green-bg);border:1px solid rgba(22,163,74,0.25);
          border-radius:100px;padding:6px 14px;
        ">
          <span style="width:6px;height:6px;border-radius:50%;background:var(--green);animation:pulse-dot 2s infinite;display:inline-block;"></span>
          <span style="font-size:12px;font-weight:700;color:var(--green);letter-spacing:0.1em;">AVAILABLE FOR REMOTE ROLES</span>
        </span>
      </div>

      <!-- Name — calibrated size, not overwhelming -->
      <h1 style="
        font-family:var(--font-head);font-weight:700;
        font-size:clamp(36px,5.5vw,64px);
        letter-spacing:-1.5px;line-height:1.1;
        color:var(--text);margin:0 0 10px;
        opacity:0;animation:fadeUp 0.65s 0.2s both;
      ">Anuj Jain</h1>

      <!-- Title line -->
      <p style="
        font-family:var(--font-body);font-size:clamp(15px,2vw,19px);
        color:var(--accent);font-weight:600;
        margin:0 0 20px;letter-spacing:0.02em;
        opacity:0;animation:fadeUp 0.65s 0.3s both;
      ">Senior Unity Developer &nbsp;·&nbsp; Mobile &nbsp;·&nbsp; WebGL &nbsp;·&nbsp; Remote</p>

      <!-- Tagline -->
      <p style="
        font-family:var(--font-body);font-size:clamp(16px,1.8vw,20px);
        color:var(--text-mid);line-height:1.65;max-width:600px;
        margin:0 0 36px;font-weight:400;
        opacity:0;animation:fadeUp 0.65s 0.4s both;
      ">
        I build game systems that scale — across titles, teams, and time zones.
        Slot frameworks, mobile games, WebGL — shipped and live.
      </p>

      <!-- CTAs -->
      <div style="display:flex;gap:10px;flex-wrap:wrap;opacity:0;animation:fadeUp 0.65s 0.5s both;">
        <button class="btn btn-primary" onclick="smoothGo('#reel')">View My Work ↓</button>
        <a href="mailto:anuj132000@gmail.com" class="btn btn-outline">Get in touch</a>
      </div>

    </div>
  </div>
</section>
