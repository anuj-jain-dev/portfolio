---
---
<nav class="nav" id="main-nav">
  <div class="nav-inner">
    <button class="nav-logo" onclick="smoothGo('#hero')">Anuj<span>.</span></button>
    <div class="nav-links">
      <button class="nav-link-item" onclick="smoothGo('#about')">About</button>
      <button class="nav-link-item" onclick="smoothGo('#skills')">Skills</button>
      <button class="nav-link-item" onclick="smoothGo('#reel')">Showcase</button>
      <button class="nav-link-item" onclick="smoothGo('#projects')">Projects</button>
      <button class="nav-link-item" onclick="smoothGo('#ai')">AI Work</button>
      <button class="nav-link-item" onclick="smoothGo('#why-me')">Why Hire Me</button>
      <button class="btn btn-primary" onclick="smoothGo('#contact')" style="padding:9px 18px;font-size:13px;">
        Contact →
      </button>
    </div>
    <button class="hamburger" id="hamburger" aria-label="Open menu"
      style="display:none;flex-direction:column;gap:5px;padding:4px;background:none;border:none;cursor:pointer;">
      <span style="display:block;width:22px;height:2px;background:var(--text);border-radius:1px;"></span>
      <span style="display:block;width:22px;height:2px;background:var(--text);border-radius:1px;"></span>
      <span style="display:block;width:22px;height:2px;background:var(--text);border-radius:1px;"></span>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobile-menu" style="display:none;">
  <button class="mobile-close" id="mobile-close">✕</button>
  {[
    ['About','#about'],
    ['Skills','#skills'],
    ['Showcase','#reel'],
    ['Projects','#projects'],
    ['AI Work','#ai'],
    ['Why Hire Me','#why-me'],
    ['Contact','#contact']
  ].map(([l,h]) => (
    <button class="mobile-menu-link" data-href={h}>{l}</button>
  ))}
</div>

<script>
  function smoothGo(id: string) {
    document.querySelector(id)?.scrollIntoView({ behavior: 'smooth' });
  }
  (window as any).smoothGo = smoothGo;

  const nav = document.getElementById('main-nav')!;
  window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 40));

  document.getElementById('hamburger')!.addEventListener('click', () => {
    document.getElementById('mobile-menu')!.style.display = 'flex';
  });
  document.getElementById('mobile-close')!.addEventListener('click', () => {
    document.getElementById('mobile-menu')!.style.display = 'none';
  });
  document.querySelectorAll('.mobile-menu-link').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('mobile-menu')!.style.display = 'none';
      document.querySelector(btn.getAttribute('data-href')!)?.scrollIntoView({ behavior: 'smooth' });
    });
  });
</script>
