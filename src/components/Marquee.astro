---
const files = await Astro.glob('../content/site/ticker.md');
const keywords: string[] = files[0]?.frontmatter?.keywords ?? [
  'Unity','C#','Scriptable Objects','Spine Animation','Unity Timeline',
  'Object Pooling','WebGL','iOS','Android','Vibe Coding','Claude AI','Remote-First'
];
const doubled = [...keywords, ...keywords];
---
<div class="marquee-wrap">
  <div class="marquee-track">
    {doubled.map((item: string) => (
      <>
        <span class="marquee-item">{item}</span>
        <span class="marquee-sep">✦</span>
      </>
    ))}
  </div>
</div>
