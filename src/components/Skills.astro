---
const skills = [
  { group: 'Core Engine',     items: ['Unity (C#)','Gameplay Systems','OOP & Design Patterns','Event Architecture','ScriptableObjects'] },
  { group: 'Game Types',      items: ['Slot Frameworks','Social Casino','Casual / Puzzle','Multiplayer','Win Presentation Systems'] },
  { group: 'Performance',     items: ['Object Pooling','Spine Optimisation','Draw Call Batching','Memory Management','WebGL Build Tuning'] },
  { group: 'Integrations',    items: ['Spine Animation','Unity Timeline','Unity Ads / LevelPlay','In-App Purchases','Addressables','SmartFoxServer'] },
  { group: 'Platforms',       items: ['iOS','Android','WebGL','Google Play Console','Apple App Store'] },
  { group: 'AI & Modern Dev', items: ['Claude AI','Vibe Coding','LLM Integration','AI-Assisted Prototyping','Generative AI Tooling'] },
];
---
<section id="skills" class="section-pad" style="background:var(--bg);">
  <div class="container">
    <div class="label reveal" style="margin-bottom:12px;">Skills & Stack</div>
    <h2 class="reveal" style="font-family:var(--font-head);font-size:clamp(24px,3.5vw,40px);font-weight:700;color:var(--text);letter-spacing:-0.8px;margin:12px 0 40px;">
      What I bring to your codebase
    </h2>
    <div style="display:flex;flex-direction:column;gap:0;">
      {skills.map((s, i) => (
        <div class="reveal" style={`display:flex;gap:clamp(14px,3vw,48px);padding:20px 0;border-bottom:1px solid var(--border);align-items:flex-start;flex-wrap:wrap;animation-delay:${i*0.06}s`}>
          <div style="min-width:130px;flex-shrink:0;padding-top:4px;">
            <span style="font-size:11px;font-weight:800;color:var(--accent);letter-spacing:0.12em;text-transform:uppercase;">{s.group}</span>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;flex:1;">
            {s.items.map(item => <span class="skill-pill">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
