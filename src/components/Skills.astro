---
const files = await Astro.glob('../content/site/skills.md');
const s = files[0]?.frontmatter ?? {};
const headline = s.headline ?? 'What I bring to your codebase';
const groups   = (s.groups ?? []).slice().sort((a: any, b: any) => (a.order ?? 99) - (b.order ?? 99));
---
<section id="skills" class="section-pad" style="background:var(--bg);">
  <div class="container">
    <div class="label reveal" style="margin-bottom:12px;">Skills & Stack</div>
    <h2 class="reveal" style="font-family:var(--font-head);font-size:clamp(22px,3vw,36px);font-weight:700;color:var(--text);letter-spacing:-0.6px;margin:10px 0 32px;">
      {headline}
    </h2>
    <div>
      {groups.map((g: any, i: number) => (
        <div class="reveal" style={`display:flex;gap:clamp(12px,3vw,48px);padding:18px 0;border-bottom:1px solid var(--border);align-items:flex-start;flex-wrap:wrap;animation-delay:${i*0.05}s`}>
          <div style="min-width:120px;flex-shrink:0;padding-top:4px;">
            <span style="font-size:11px;font-weight:800;color:var(--accent);letter-spacing:0.12em;text-transform:uppercase;">{g.group}</span>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;flex:1;">
            {(g.items ?? []).map((item: string) => <span class="skill-pill">{item}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
