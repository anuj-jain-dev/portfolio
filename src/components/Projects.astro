---
interface Project {
  data: {
    title: string; subtitle: string; status: string;
    platform: string; studio: string; year: string;
    order: number; featured: boolean;
    mediaType: string; mediaSrc?: string;
    cloudinaryVideo?: string; youtubeId?: string;
    storeLink?: string; storeLinkLabel?: string;
    githubLink?: string;
    techChallenge: string; businessOutcome: string; codeSignals: string;
    tags: string[]; metrics: string[]; accent: string;
  };
  slug: string;
}
interface Props { projects: Project[]; }
const { projects } = Astro.props;
const statusColor: Record<string,string> = {
  LIVE:'#16a34a', CURRENT:'#1a56db', SHIPPED:'#92400e', WIP:'#b45309'
};
---

<section id="projects" class="section-pad" style="background:var(--bg);">
  <div class="container">

    <div class="label reveal" style="margin-bottom:12px;">Projects</div>
    <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:48px;">
      <h2 class="reveal" style="font-family:var(--font-head);font-size:clamp(24px,3.5vw,40px);font-weight:700;color:var(--text);letter-spacing:-0.8px;margin:0;">
        Shipped work, real products
      </h2>
      <p class="reveal" style="font-family:var(--font-body);font-size:14px;color:var(--text-muted);max-width:360px;line-height:1.65;margin:0;">
        Architecture decisions, outcomes, code quality signals — the full picture behind each title.
      </p>
    </div>

    <div style="display:flex;flex-direction:column;gap:24px;">
      {projects.map((project, i) => {
        const p = project.data;
        const sc = statusColor[p.status] ?? '#8a8680';
        return (
          <article class="proj-card reveal" style={`animation-delay:${i*0.07}s`}>

            <!-- FULL-WIDTH MEDIA on top -->
            <div class="proj-media">
              {p.mediaType === 'youtube' && p.youtubeId ? (
                <div style="position:relative;padding-top:56.25%;">
                  <iframe
                    src={`https://www.youtube.com/embed/${p.youtubeId}?autoplay=0&rel=0&modestbranding=1`}
                    style="position:absolute;inset:0;width:100%;height:100%;border:none;"
                    allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture"
                    allowfullscreen loading="lazy" title={p.title}
                  />
                </div>
              ) : p.mediaType === 'video' && p.cloudinaryVideo ? (
                <video src={p.cloudinaryVideo} autoplay muted loop playsinline
                  style="width:100%;max-height:560px;object-fit:cover;" />
              ) : p.mediaSrc ? (
                <img src={p.mediaSrc} alt={`${p.title} gameplay`}
                  style="width:100%;max-height:560px;object-fit:cover;" loading="lazy" />
              ) : (
                <div class="proj-media-placeholder">
                  <div style="font-size:48px;">🎮</div>
                  <p style="font-size:13px;color:rgba(255,255,255,0.3);font-weight:600;letter-spacing:0.08em;text-transform:uppercase;text-align:center;padding:0 20px;margin:0;">
                    {p.title} · Upload GIF or MP4 via /admin
                  </p>
                </div>
              )}

              {/* Accent bar at bottom of media */}
              <div style={`height:3px;background:${p.accent};`}></div>
            </div>

            <!-- Project details below media, full width -->
            <div class="proj-body">

              <!-- Status + meta row -->
              <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px;">
                <span style={`font-size:11px;font-weight:800;color:${sc};letter-spacing:0.12em;display:flex;align-items:center;gap:6px;`}>
                  <span style={`width:6px;height:6px;border-radius:50%;background:${sc};display:inline-block;${p.status==='LIVE'||p.status==='CURRENT'?'animation:pulse-dot 2s infinite;':''}`}></span>
                  {p.status}
                </span>
                <span class="tag-gray">{p.platform}</span>
                <span class="tag-gray">{p.studio}</span>
                <span style="font-size:12px;color:var(--text-muted);margin-left:auto;">{p.year}</span>
              </div>

              <!-- Title + subtitle -->
              <h3 style="font-family:var(--font-head);font-size:clamp(20px,2.5vw,28px);font-weight:700;color:var(--text);letter-spacing:-0.3px;margin:0 0 4px;line-height:1.2;">
                {p.title}
              </h3>
              <p style="font-size:14px;color:var(--text-muted);font-weight:500;margin:0 0 20px;">
                {p.subtitle}
              </p>

              <!-- Case study: 3 columns on desktop -->
              <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-bottom:20px;padding:20px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);">
                {[
                  ['⚙ Tech Challenge', p.techChallenge],
                  ['📈 Outcome', p.businessOutcome],
                  ['🔍 Code Quality', p.codeSignals],
                ].map(([h, b]) => (
                  <div>
                    <div style={`font-size:10px;font-weight:800;color:${p.accent};letter-spacing:0.14em;text-transform:uppercase;margin-bottom:6px;`}>{h}</div>
                    <p style="font-size:13px;color:var(--text-mid);line-height:1.7;margin:0;">{b}</p>
                  </div>
                ))}
              </div>

              <!-- Tags + links row -->
              <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
                <div style="display:flex;flex-wrap:wrap;gap:6px;">
                  {p.tags.map(t => <span class="tag">{t}</span>)}
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap;">
                  {p.storeLink && (
                    <a href={p.storeLink} target="_blank" rel="noopener" class="btn btn-primary" style="font-size:13px;padding:9px 18px;">
                      {p.storeLinkLabel || 'View Live →'}
                    </a>
                  )}
                  {p.githubLink && (
                    <a href={p.githubLink} target="_blank" rel="noopener" class="btn btn-outline" style="font-size:13px;padding:8px 16px;">
                      GitHub ↗
                    </a>
                  )}
                </div>
              </div>

            </div>
          </article>
        );
      })}
    </div>

    <!-- Add more -->
    <div class="reveal" style="margin-top:20px;border:2px dashed var(--border2);border-radius:var(--radius-lg);padding:36px;text-align:center;">
      <p style="font-size:15px;color:var(--text-muted);font-weight:600;margin:0 0 4px;">More projects on the way</p>
      <p style="font-size:13px;color:var(--text-muted);opacity:0.6;margin:0;">
        Add new projects at <strong style="color:var(--accent);">yoursite.netlify.app/admin</strong> — no code needed
      </p>
    </div>

  </div>
</section>
