---
const files = await Astro.glob('../content/site/aiwork.md');
const a = files[0]?.frontmatter ?? {};
const headline    = a.headline    ?? 'Pushing beyond Unity';
const subheadline = a.subheadline ?? '';
const cards       = a.cards       ?? [];
const note        = a.note        ?? '';
---
<section id="ai" class="section-pad" style="background:var(--bg2);">
  <div class="container">
    <div class="label reveal" style="margin-bottom:10px;">AI Experiments</div>
    <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:32px;">
      <h2 class="reveal" style="font-family:var(--font-head);font-size:clamp(22px,3vw,38px);font-weight:700;color:var(--text);letter-spacing:-0.6px;margin:0;">{headline}</h2>
      {subheadline && <p class="reveal" style="font-size:14px;color:var(--text-muted);max-width:380px;line-height:1.6;margin:0;">{subheadline}</p>}
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;">
      {cards.map((card: any, i: number) => (
        <div class="ai-card reveal" style={`animation-delay:${i*0.07}s`}>
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
            <span style="font-size:22px;">{card.icon}</span>
            <span class="tag">{card.status}</span>
          </div>
          <h3 style="font-family:var(--font-head);font-size:16px;font-weight:700;color:var(--text);margin:0 0 9px;line-height:1.3;">{card.title}</h3>
          <p style="font-size:13px;color:var(--text-mid);line-height:1.7;margin:0 0 13px;">{card.body}</p>
          <div style="display:flex;flex-wrap:wrap;gap:5px;">
            {(card.tags ?? []).map((t: string) => <span class="tag">{t}</span>)}
          </div>
        </div>
      ))}
    </div>
    {note && (
      <div class="reveal" style="margin-top:16px;padding:18px 22px;background:var(--accent-bg);border:1px solid rgba(26,86,219,0.15);border-radius:var(--radius-lg);display:flex;align-items:flex-start;gap:12px;flex-wrap:wrap;">
        <span style="font-size:18px;flex-shrink:0;">💡</span>
        <p style="font-size:14px;color:var(--text-mid);line-height:1.65;margin:0;">{note}</p>
      </div>
    )}
  </div>
</section>
