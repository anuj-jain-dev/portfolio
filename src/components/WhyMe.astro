---
const files = await Astro.glob('../content/site/whyme.md');
const w = files[0]?.frontmatter ?? {};
const headline     = w.headline     ?? 'What you actually care about';
const subheadline  = w.subheadline  ?? '';
const pullQuote    = w.pullQuote    ?? '';
const pullQuoteSub = w.pullQuoteSub ?? '';
const cards        = w.cards        ?? [];
---
<section id="why-me" class="section-pad" style="background:var(--bg);">
  <div class="container">
    <div class="label reveal" style="margin-bottom:10px;">Why Hire Me</div>
    <div style="display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:32px;">
      <h2 class="reveal" style="font-family:var(--font-head);font-size:clamp(22px,3vw,38px);font-weight:700;color:var(--text);letter-spacing:-0.6px;margin:0;">{headline}</h2>
      {subheadline && <p class="reveal" style="font-size:14px;color:var(--text-muted);max-width:360px;line-height:1.6;margin:0;">{subheadline}</p>}
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;">
      {cards.map((card: any, i: number) => (
        <div class="why-card reveal" style={`animation-delay:${i*0.06}s`}>
          <div style="font-size:22px;margin-bottom:12px;">{card.icon}</div>
          <h3 style="font-family:var(--font-head);font-size:15px;font-weight:700;color:var(--text);margin:0 0 9px;line-height:1.3;">{card.title}</h3>
          <p style="font-size:13px;color:var(--text-mid);line-height:1.75;margin:0 0 14px;">{card.body}</p>
          <div style="display:inline-flex;align-items:center;gap:5px;background:var(--accent-bg);border:1px solid rgba(26,86,219,0.15);border-radius:100px;padding:3px 10px;">
            <span style="width:5px;height:5px;border-radius:50%;background:var(--accent);display:inline-block;flex-shrink:0;"></span>
            <span style="font-size:11px;font-weight:700;color:var(--accent);letter-spacing:0.03em;">{card.proof}</span>
          </div>
        </div>
      ))}
    </div>
    {pullQuote && (
      <div class="reveal" style="margin-top:20px;padding:24px 28px;background:var(--text);border-radius:var(--radius-lg);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;">
        <div>
          <p style="font-size:16px;color:#fff;font-weight:700;margin:0 0 4px;line-height:1.4;">"{pullQuote}"</p>
          {pullQuoteSub && <p style="font-size:13px;color:rgba(255,255,255,0.5);margin:0;">{pullQuoteSub}</p>}
        </div>
        <button class="btn" onclick="smoothGo('#contact')"
          style="background:#fff;color:var(--text);padding:11px 22px;font-size:14px;border-radius:var(--radius);font-weight:700;flex-shrink:0;">
          Get in touch →
        </button>
      </div>
    )}
  </div>
</section>
